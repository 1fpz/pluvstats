# ─────────────────────────────────────────────────────────────
# PLUVSTATS — example environment (never commit real secrets)
# Copy to .env and adjust. Values below are development defaults.
# ─────────────────────────────────────────────────────────────

# Frontend (Vite). Only public, non-secret values belong here.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WEATHER_BASE_URL=https://api.open-meteo.com/v1
VITE_OPERATION_MODE=demo
VITE_WEATHER_CACHE_TTL_MINUTES=15

# Backend
PLUVSTATS_ENV=development
PLUVSTATS_DATABASE_PATH=backend/data/pluvstats.db
PLUVSTATS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret expected in the X-Device-Token header of hardware ingestion.
# This is a placeholder contract, not a real deployed credential.
PLUVSTATS_HARDWARE_INGEST_TOKEN=change-me-development-only
# A reading older than this is not considered proof of connectivity.
PLUVSTATS_READING_MAX_AGE_SECONDS=180
