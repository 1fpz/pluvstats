# Backend configuration. Copy to `.env` and adjust only for local development.
# The default demo mode never opens the hardware ingestion endpoint.
PLUVSTATS_ENV=demo
PLUVSTATS_DB_PATH=backend/data/pluvstats.db
PLUVSTATS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PLUVSTATS_HARDWARE_ENABLED=false
# Required only when hardware ingestion is enabled. Never commit a real key.
PLUVSTATS_HARDWARE_KEY=
