# Frontend configuration (Vite reads files from the `frontend/` directory).
# Copy this file to `frontend/.env` and adjust.
#
# Leave VITE_API_BASE_URL empty to run only the local demonstration repository.
# Set it to the FastAPI address to use the backend. If the API is unreachable,
# the frontend falls back to the local demo and reports the fallback in Diagnóstico.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WEATHER_BASE_URL=https://api.open-meteo.com/v1
VITE_OPERATION_MODE=demo
VITE_WEATHER_CACHE_TTL_MINUTES=15
